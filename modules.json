        "package_selection": {
          "github.com/faustbrian/go-webhook": "Use for generic webhook signing, verification, replay rejection, bounded HTTP delivery, and privacy-safe observations; select an adapter only when integrating an existing idempotency, queue, outbox, logging, or telemetry owner.",
          "github.com/faustbrian/go-webhook/adapters/idempotency": "Use to adapt the webhook replay contract to a caller-supplied Golib idempotency store.",
          "github.com/faustbrian/go-webhook/adapters/otel": "Use to record bounded webhook observations and instrument an explicitly supplied secure HTTP client with a caller-owned telemetry runtime.",
          "github.com/faustbrian/go-webhook/adapters/outbox": "Use to encode delivery requests for a caller-owned transactional outbox and publish them through an explicitly supplied Deliverer.",
          "github.com/faustbrian/go-webhook/adapters/queue": "Use to encode webhook delivery work for a caller-owned queue whose durable layer owns retries and settlement.",
          "github.com/faustbrian/go-webhook/adapters/slog": "Use to map privacy-safe webhook observations to an explicitly supplied slog logger.",
          "github.com/faustbrian/go-webhook/webhooktest": "Use in tests for deterministic signer, verifier, clock, nonce, and delivery fixtures without changing process-global state."
